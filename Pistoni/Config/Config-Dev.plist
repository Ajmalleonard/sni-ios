<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Environment</key>
	<string>Development</string>
	<key>GooglePlacesAPIKey</key>
	<string>YOUR_DEV_GOOGLE_PLACES_API_KEY_HERE</string>
	<key>BackendBaseURL</key>
	<string>https://api.snicolt.com</string>
	<key>EnableLogging</key>
	<true/>
	<key>EnableAnalytics</key>
	<false/>
	<key>APITimeout</key>
	<integer>30</integer>
	<key>SocketIOURL</key>
	<string>wss://dev-socket.snicolt.com</string>
	<key>FirebaseProjectID</key>
	<string>sni-rentals-dev</string>
	<key>EnableDebugFeatures</key>
	<true/>
	<key>MockDataEnabled</key>
	<true/>
</dict>
</plist>

<!-- 
DEVELOPMENT CONFIGURATION
========================

This configuration is used for local development and testing.

Features:
- Extended API timeouts for debugging
- Detailed logging enabled
- Analytics disabled to avoid test data
- Mock data support for offline development
- Debug features enabled

Setup Instructions:
1. Replace YOUR_DEV_GOOGLE_PLACES_API_KEY_HERE with your development API key
2. Ensure dev-api.snicolt.com points to your development backend
3. Configure Firebase project for development environment
4. This file should be committed to version control for team consistency
-->